# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# Optional - secondary/fallback chat model, used when the primary model is
# rate-limited or its daily quota is exhausted. On the free tier, "Flash
# Lite" generations usually carry a much higher daily request cap (RPD)
# than full "Flash" models - check Google AI Studio's rate-limits page, and
# get the exact model id (not just the display name) by running
# `python backend/scripts/list_models.py`.
GEMINI_FALLBACK_MODEL=models/gemini-flash-lite-latest

# Optional - third-tier safety net, tried only if BOTH the models above are
# exhausted. Pick a model with an even bigger daily quota (e.g. an open
# Gemma model, which typically has a far higher RPD but somewhat lower
# quality than Gemini Flash). Leave unset to disable this tier.
GEMINI_SAFETY_NET_MODEL=

# OpenWeather API Key
OPENWEATHER_API_KEY=your_openweather_api_key

# Google Cloud Speech-to-Text + Text-to-Speech (used by /chat/speech-chat,
# the record-and-send voice fallback). Path to the service account JSON key
# you download from Google Cloud Console - see backend/README (or ask the
# assistant) for the step-by-step setup. Never commit the actual key file.
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json