# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# OpenWeather API Key
OPENWEATHER_API_KEY=your_openweather_api_key

# PostgreSQL connection string used to store the rolling 30-day market
# price history that powers the price trend chart.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cropiq

# Optional: how many days of price history to keep before rows expire (default 30)
PRICE_HISTORY_RETENTION_DAYS=30

# Optional: how often (seconds) the background job re-fetches today's prices
# and purges expired rows. Default is 86400 (once every 24h).
PRICE_COLLECTION_INTERVAL_SECONDS=86400